{
  "name": "khhan.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:static": "node scripts/sync-static.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:yaml-format": "node scripts/normalize-yaml.mjs --check",
    "validate": "npm run validate:content && npm run validate:links && npm run validate:yaml-format",
    "normalize:yaml": "node scripts/normalize-yaml.mjs",
    "dev": "npm run sync:static && astro dev",
    "build": "npm run sync:static && astro build",
    "preview": "astro preview",
    "test": "node --test tests/unit.test.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5",
    "wrangler": "^4.140.0"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "js-yaml": "^4.3.2",
    "sanitize-html": "^2.17.7"
  }
}
