---
// /admin 은 이 사이트에서 유일하게 SSR 로 도는 구간이다.
// 실제 관리 UI 는 P2/P3 에서 채운다. 지금은 인증 배선 확인용 셸이다.
export const prerender = false;

import { requireSession, HttpError } from '../../lib/admin/auth.js';

let session;
try {
  session = await requireSession(Astro);
} catch (err) {
  // 로그인 안 됨 → 로그인 시작. 그 외(403 등)는 화면에 이유를 보여준다.
  if (err instanceof HttpError && err.status === 401) {
    return Astro.redirect('/admin/auth/login?returnTo=/admin', 302);
  }
  const status = err instanceof HttpError ? err.status : 500;
  return new Response(`접근할 수 없습니다: ${err.message}`, {
    status,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>khhan.com 관리</title>
  </head>
  <body>
    <h1>khhan.com 관리</h1>
    <p>
      <strong>{session.login}</strong> 으로 로그인되었습니다.
      {session.dev && <em>(로컬 개발 우회)</em>}
    </p>
    <p>관리 UI 는 아직 준비 중입니다.</p>
    <form method="POST" action="/admin/auth/logout">
      <button type="submit">로그아웃</button>
    </form>
  </body>
</html>
