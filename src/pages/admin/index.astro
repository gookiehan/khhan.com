---
// /admin 은 이 사이트에서 유일하게 SSR 로 도는 구간이다.
// 실제 관리 UI 는 P2/P3 에서 채운다. 지금은 라우팅·인증 배선이 맞는지
// 확인하기 위한 최소 셸이다.
export const prerender = false;

// Cloudflare Access 가 앞단에 붙으면 이 헤더가 주입된다.
// (아직 Access 를 걸기 전이라 없을 수 있다 — 그건 정상)
const accessEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');
const hasAccessJwt = Astro.request.headers.get('Cf-Access-Jwt-Assertion') !== null;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>khhan.com 관리</title>
  </head>
  <body>
    <h1>khhan.com 관리</h1>
    <p>SSR 라우트가 동작합니다. 관리 UI 는 아직 준비 중입니다.</p>
    <dl>
      <dt>Cf-Access-Authenticated-User-Email</dt>
      <dd>{accessEmail ?? '(없음 — Access 미적용 상태)'}</dd>
      <dt>Cf-Access-Jwt-Assertion</dt>
      <dd>{hasAccessJwt ? '있음' : '(없음 — Access 미적용 상태)'}</dd>
    </dl>
  </body>
</html>
